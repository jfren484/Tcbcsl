@model StandingsTeamModel
<tr>
    <td>@(Model.ClinchChar == null ? null : $"{Model.ClinchChar} - ") @Html.TeamLink(Model.TeamName, Model.TeamId, Model.Year)</td>
    <td>@Model.DivisionWins</td>
    <td>@Model.DivisionLosses</td>
    <td class="tiesColumn">@Model.DivisionTies</td>
    <td>@Model.DivisionWinningPercentage.ToString(Consts.Decimal3PlacesFormat)</td>
    <td>@Model.DivisionGamesBack.ToString(Consts.GamesBackFormat)</td>
    <td class="hidden-xs">@Model.DivisionRunsScored</td>
    <td class="hidden-xs">@Model.DivisionRunsAllowed</td>
    <td class="hidden-xs">@(Model.DivisionRunsScored - Model.DivisionRunsAllowed)</td>
    <td class="hidden-xs">
        @if (Model.StreakCount > 0)
        {
            <text>@Consts.GameOutcomeVerbs[Model.StreakOutcome] @Model.StreakCount</text>
        }
    </td>
    <td class="hidden-xs">@ScheduleService.FormatRecord(Model.Last5Wins, Model.Last5Losses, Model.Last5Ties)</td>
    <td class="hidden-xs">@ScheduleService.FormatRecord(Model.TotalWins, Model.TotalLosses, Model.TotalTies)</td>
</tr>
